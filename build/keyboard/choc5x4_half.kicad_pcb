(footprint "keyboard-design:choc" (layer "F.Cu")
(at 60 81.9 0)
(descr "Combined PG1350 V1 / PG1353 V2 pattern: two V1 locating holes on the moving island; V2 support slot plated, unnumbered and unconnected. No LED aperture. Switch on top; solder pads B.Cu/B.Mask only; fixed orientation, no hotswap.")
(attr through_hole)
(path "/56f1b537-b280-4b26-ac0b-458bd9a6e50b/ee718602-77c9-4d75-a0f3-f3f69e9ece61")
